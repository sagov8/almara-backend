# ==============================================================================
# ALMARA BACKEND - PLANTILLA DE CONFIGURACIÓN (application.yml.example)
# Copia este archivo como 'application.yml' o configura las variables de entorno.
# NUNCA agregues claves privadas reales en este archivo versionado en Git.
# ==============================================================================

server:
  port: ${PORT:8080}

spring:
  application:
    name: almara-backend

  # 1. Base de Datos Principal (PostgreSQL + PostGIS)
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:postgresql://${POSTGRES_HOST:localhost}:${POSTGRES_PORT:5432}/${POSTGRES_DB:almara_db}}
    username: ${SPRING_DATASOURCE_USERNAME:almara_user}
    password: ${SPRING_DATASOURCE_PASSWORD:tu_password_seguro_postgres}
    driver-class-name: ${SPRING_DATASOURCE_DRIVER:org.postgresql.Driver}

  jpa:
    hibernate:
      ddl-auto: none
    open-in-view: false

  flyway:
    enabled: true
    baseline-on-migrate: true
    locations: classpath:db/migration

  # 2. Redis (Caché, Control de Frecuencia y Revocación de Tokens)
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:tu_password_seguro_redis}
      timeout: 2000ms

  # 3. Servidor de Correo SMTP (Despacho de Códigos de Verificación y Notificaciones)
  mail:
    host: ${SPRING_MAIL_HOST:smtp.gmail.com}
    port: ${SPRING_MAIL_PORT:587}
    username: ${SPRING_MAIL_USERNAME:tu_correo_corporativo@gmail.com}
    password: ${SPRING_MAIL_PASSWORD:tu_app_password_o_clave_smtp}
    properties:
      mail:
        from: ${ALMARA_MAIL_FROM:no-reply@almara.co}
        host: localhost
        smtp:
          auth: true
          localhost: localhost
          quitwait: false
          starttls:
            enable: true
            required: true
          ssl:
            trust: "*"
            protocols: TLSv1.2 TLSv1.3
          connectiontimeout: 3000
          timeout: 3000
          writetimeout: 3000

# 4. Parámetros de Dominio y Negocio Almara
almara:
  emocion:
    # Lapso de bloqueo obligatorio entre reportes de la misma sesión (15 min = 900 s)
    segundos-bloqueo: 900

  h3:
    # Resolución estándar H3 para hexágonos urbanos (~100m - ~450m, Popayán)
    default-resolution: 9

  privacy:
    # k-anonimato base mínimo
    default-k-anonymity: 5

  # Seguridad y Tokens JWT
  seguridad:
    admin-jwt-secret: ${ALMARA_ADMIN_JWT_SECRET:almara-admin-super-secure-secret-key-2026-popayan}
    admin-jwt-expiracion-segundos: ${ALMARA_ADMIN_JWT_EXPIRACION:28800}
    jwt-secret: ${ALMARA_JWT_SECRET:almara-institutional-secret-key-2026-urban-intelligence-min-32-chars}
    jwt-expiracion-segundos: ${ALMARA_JWT_EXPIRACION_SEGUNDOS:28800}

  # Notificaciones Transaccionales
  notificaciones:
    # 'smtp' para envío de correos reales a través del servidor SMTP configurado; 'simulado' para pruebas
    proveedor: ${ALMARA_NOTIFICACIONES_PROVEEDOR:smtp}
    remitente: ${ALMARA_MAIL_FROM:no-reply@almara.co}
    smtp:
      espera-maxima-verificacion-ms: ${ALMARA_SMTP_ESPERA_VERIFICACION_MS:2200}
      espera-maxima-confirmacion-ms: ${ALMARA_SMTP_ESPERA_CONFIRMACION_MS:500}

  # 5. Integración con Pasarela de Pagos SaaS (Stripe)
  pagos:
    # Opciones: 'stripe' (Stripe Test Mode / Producción) o 'simulado'
    proveedor: ${ALMARA_PAGOS_PROVEEDOR:stripe}
    stripe:
      api-url: ${STRIPE_API_URL:https://api.stripe.com/v1}
      publishable-key: ${STRIPE_PUBLISHABLE_KEY:pk_test_tu_clave_publica_aqui}
      secret-key: ${STRIPE_SECRET_KEY:sk_test_tu_clave_secreta_aqui}
      webhook-secret: ${STRIPE_WEBHOOK_SECRET:whsec_tu_webhook_secret_aqui}
      moneda: ${STRIPE_MONEDA:cop}
